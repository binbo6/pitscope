# Optional: offline retrieval and report export work without a model or a key.
PIT_LLM_BASE_URL=https://api.deepseek.com
PIT_LLM_MODEL=deepseek-chat
PIT_LLM_API_KEY=
# To use a local compatible service:
# PIT_LLM_BASE_URL=http://127.0.0.1:1234/v1
# PIT_LLM_MODEL=your-local-model
# External env files are read only if explicitly requested:
# PIT_ENV_FILE=/path/to/your/provider.env
